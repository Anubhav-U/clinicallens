# Copy to .env.local and fill in. Never commit .env.local.

# Free key from Google AI Studio (personal Google account, billing NOT enabled).
GEMINI_API_KEY=
# Optional overrides. Defaults: gemini-3.5-flash-lite, thinking "minimal" (minimal | low | medium | high).
GEMINI_MODEL=
GEMINI_THINKING=

# Optional locally: rate limiting is skipped (with a warning) when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
